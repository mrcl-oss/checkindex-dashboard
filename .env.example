# Port configuration (default: 6767)
# Copy this file to .env to override settings:
#   cp .env.example .env
PORT=6767

# Optional: Full listen address override
# CHECKINDEX_DASHBOARD_LISTEN_ADDR=0.0.0.0:6767

# Optional: Background collection refresh interval (default: 60s)
# CHECKINDEX_DASHBOARD_REFRESH_INTERVAL=60s

